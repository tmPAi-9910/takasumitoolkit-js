{
  "name": "takasumibot-kit",
  "version": "0.1.0",
  "description": "TypeScript client SDK for the TakasumiBOT public API (v3), generated from TakasumiBOT-OpenAPI-Document.json.",
  "keywords": [
    "takasumibot",
    "takasumi",
    "api",
    "client",
    "sdk",
    "typescript"
  ],
  "license": "MIT",
  "author": "<Your Name>",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "generate:types": "openapi-typescript TakasumiBOT-OpenAPI-Document.json -o src/generated/openapi.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "openapi-typescript": "^7.9.1",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0",
    "vitest": "^3.2.4"
  }
}
